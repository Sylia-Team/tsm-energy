# URL publique du site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.tsm83.com

# Logs analytics en développement uniquement
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# Envoi des leads : "log" (défaut, journal serveur) ou "webhook".
# LEAD_ADAPTER=webhook
# URL du webhook (n8n, Make, Zapier, CRM…) — requise si LEAD_ADAPTER=webhook
# LEAD_WEBHOOK_URL=https://example.com/webhook/lead
# Secret optionnel, envoyé en en-tête "Authorization: Bearer …"
# LEAD_WEBHOOK_SECRET=

# Administration du contenu (/admin)
# Mot de passe unique d'accès à l'espace d'administration
ADMIN_PASSWORD=
# Secret de signature du cookie de session (>= 16 caractères, aléatoire)
ADMIN_SESSION_SECRET=change-me-with-a-long-random-string

# Avis Google (API Google Places v1) — clé serveur, jamais exposée au client.
# Le Place ID et les options se règlent depuis /admin/avis.
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
